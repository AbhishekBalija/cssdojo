# Copy to .env.local for local development. Never commit real values.

# Postgres. docker compose provides a local one at this URL.
DATABASE_URL=postgres://dojo:dojo@localhost:5432/cssdojo

# Public URLs (no trailing slash)
API_URL=http://localhost:8787
CLIENT_URL=http://localhost:5173

# Better Auth. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me

# OAuth apps (optional locally). See docs/guides/oauth.md
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Dev-only test login. Never enable in production.
ENABLE_TEST_LOGIN=true

# Run the scorer worker inside the API process (one container on Render free).
RUN_SCORER_IN_PROCESS=true

# Deploys only. See docs/guides/render.md
RENDER_API_KEY=
